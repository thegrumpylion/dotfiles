#!/usr/bin/env bash
# mlock — machine-sharing lock for concurrent agent sessions.
#
# Heavy work takes one of N slots (N = cores/4, at least 1) and a shared
# hold on the machine lock; a quiet need (benchmark, measurement) takes
# the machine lock exclusively, which waits for every running heavy
# holder to finish (the drain) and excludes new ones for its duration.
# flock(2) semantics give crash-release for free: a dead holder's locks
# vanish with its process. A `.wanted` marker gives quiet priority —
# flock has none — and carries the reason; its TTL bounds a crashed
# quiet-seeker.
#
# Every wait is bounded so one call fits inside one agent tool call; on
# timeout mlock exits 75 (EX_TEMPFAIL) with the reason on stderr and the
# caller reruns the same call. `run` keeps its bound short so the work
# it starts always has a fresh call budget of its own; a background
# caller raises MLOCK_RUN_WAIT. The load average is never consulted: it
# is a low-pass filter of everyone's work and never reads free beside a
# steady neighbour.
#
#   mlock run <cmd...>              wait for a heavy slot and a shared
#                                   hold (MLOCK_RUN_WAIT, 30s), then run
#                                   <cmd>; exit 75 = rerun the same call
#   mlock quiet <reason> <cmd...>   run <cmd> with the machine quiet;
#                                   drain bounded by MLOCK_QUIET_WAIT
#                                   (7200s); the hold itself bounded by
#                                   MLOCK_QUIET_MAX (3600s) — past it the
#                                   command is interrupted and mlock
#                                   exits 124, so no quiet run can hold
#                                   the machine longer than its caller
#                                   said it needed
#   mlock check                     exit 0 if heavy work may start now;
#                                   exit 1 and print why if not
#   mlock status                    human-readable state, the quiet
#                                   holder's reason, age and bound
#                                   included
#
# Environment: MLOCK_FILE (default ~/.machine.lock), MLOCK_SLOTS
# (default nproc/4, at least 1), MLOCK_TTL (wanted marker, default 7200),
# MLOCK_QUIET_WAIT (drain bound, default 7200), MLOCK_QUIET_MAX (hold
# bound, default 3600).
set -euo pipefail

LOCK="${MLOCK_FILE:-$HOME/.machine.lock}"
WANTED="$LOCK.wanted"
QUIETREC="$LOCK.quiet"
TTL_SECONDS="${MLOCK_TTL:-7200}"
QUIET_WAIT="${MLOCK_QUIET_WAIT:-7200}"
QUIET_MAX="${MLOCK_QUIET_MAX:-3600}"
RUN_WAIT="${MLOCK_RUN_WAIT:-30}"
cores=$(nproc 2>/dev/null || echo 4)
SLOTS="${MLOCK_SLOTS:-$(( cores / 4 > 0 ? cores / 4 : 1 ))}"
TEMPFAIL=75

touch "$LOCK"

fresh() { # marker exists and is younger than the TTL
	# One stat is both the existence probe and the mtime read: a marker
	# removed concurrently (a quiet holder's EXIT trap) must read as
	# "not wanted", never crash the arithmetic.
	local mtime
	mtime=$(stat -c %Y "$1" 2>/dev/null) || return 1
	local age=$(($(date +%s) - mtime))
	[ "$age" -le "$TTL_SECONDS" ]
}

wanted_reason() { cat "$WANTED" 2>/dev/null || echo '?'; }
quiet_record() { cat "$QUIETREC" 2>/dev/null || echo '?'; }
slot_file() { printf '%s.slot.%d' "$LOCK" "$1"; }

free_slot() { # prints the index of a free slot; exit 1 when all are busy
	local i
	for ((i = 0; i < SLOTS; i++)); do
		if flock -n -x "$(slot_file "$i")" true 2>/dev/null; then
			echo "$i"
			return 0
		fi
	done
	return 1
}

slot_holders() { # one line per busy slot: what `run` recorded when it took it
	local i f
	for ((i = 0; i < SLOTS; i++)); do
		f=$(slot_file "$i")
		if [ -e "$f" ] && ! flock -n -x "$f" true 2>/dev/null; then
			printf '  slot %d: %s\n' "$i" "$(head -c 200 "$f" 2>/dev/null | tr '\n' ' ')"
		fi
	done
}

blocked_reason() { # prints why heavy work may not start now; exit 0 when it may
	if fresh "$WANTED"; then
		echo "quiet wanted: $(wanted_reason)"
		return 1
	fi
	if ! flock -n -s "$LOCK" true 2>/dev/null; then
		echo "machine quiet: $(quiet_record)"
		return 1
	fi
	if ! free_slot >/dev/null; then
		printf 'all %d heavy slots busy:\n%s' "$SLOTS" "$(slot_holders)"
		return 1
	fi
	return 0
}

case "${1:-help}" in
run)
	shift
	[ "$#" -ge 1 ] || { echo "mlock run: missing command" >&2; exit 2; }
	deadline=$(($(date +%s) + RUN_WAIT))
	while :; do
		if ! fresh "$WANTED" && flock -n -s "$LOCK" true 2>/dev/null && i=$(free_slot); then
			slot=$(slot_file "$i")
			# Append-open, then lock: the file is truncated only once the
			# slot is ours, so a concurrent holder's record is never wiped.
			exec {sfd}>>"$slot"
			if flock -n -x "$sfd"; then
				: >"$slot"
				printf 'pid %s since %s: %s\n' "$$" "$(date -Is)" "$*" >&"$sfd"
				rem=$((deadline - $(date +%s)))
				[ "$rem" -gt 0 ] || rem=1
				# The slot fd is inherited through the exec: the slot stays
				# taken for the whole process tree and frees when it exits.
				# A quiet holder arriving meanwhile waits on our shared hold.
				exec flock -s -w "$rem" -E "$TEMPFAIL" "$LOCK" "$@"
			fi
			exec {sfd}>&-
		fi
		if [ "$(date +%s)" -ge "$deadline" ]; then
			echo "mlock run: could not start within ${RUN_WAIT}s — $(blocked_reason || true)" >&2
			exit "$TEMPFAIL"
		fi
		sleep 1
	done
	;;
quiet)
	shift
	[ "$#" -ge 2 ] || { echo "mlock quiet: usage: mlock quiet <reason> <cmd...>" >&2; exit 2; }
	reason="$1"
	shift
	printf '%s (pid %s, since %s)\n' "$reason" "$$" "$(date -Is)" >"$WANTED"
	trap 'rm -f "$WANTED" "$QUIETREC"' EXIT
	# The exclusive hold rides an fd this shell keeps open, so the drain
	# (-x waits for every shared holder to release) and the run are one
	# hold, inherited by the command's process tree.
	exec {qfd}>>"$LOCK"
	if ! flock -x -w "$QUIET_WAIT" -E "$TEMPFAIL" "$qfd"; then
		echo "mlock quiet: the machine did not drain within ${QUIET_WAIT}s — $reason" >&2
		exit "$TEMPFAIL"
	fi
	# Held. The wanted marker has done its job (priority while waiting);
	# the quiet record now carries the holder for status and check.
	rm -f "$WANTED"
	# The hold is bounded: a quiet run that outlives its stated bound is
	# interrupted rather than left holding the machine against everyone.
	# INT first so a measurement can render its ending; TERM 30s later;
	# timeout's own KILL after that.
	timeout --foreground --signal=INT --kill-after=30 "$QUIET_MAX" "$@" &
	child=$!
	printf '%s (pid %s, child %s, since %s, bound %ss)\n' "$reason" "$$" "$child" "$(date -Is)" "$QUIET_MAX" >"$QUIETREC"
	exec_status=0
	wait "$child" || exec_status=$?
	if [ "$exec_status" -eq 124 ]; then
		echo "mlock quiet: hold bound of ${QUIET_MAX}s reached — $reason interrupted; a longer quiet run sets MLOCK_QUIET_MAX to what it needs" >&2
	fi
	exit "$exec_status"
	;;
check)
	if reason=$(blocked_reason); then
		echo "free"
	else
		echo "$reason"
		exit 1
	fi
	;;
status)
	if fresh "$WANTED"; then
		echo "quiet wanted: $(wanted_reason)"
	elif [ -e "$WANTED" ]; then
		echo "stale wanted marker (older than ${TTL_SECONDS}s): $(wanted_reason)"
	fi
	if ! flock -n -s "$LOCK" true 2>/dev/null; then
		echo "exclusive holder active (machine quiet): $(quiet_record)"
	elif ! flock -n -x "$LOCK" true 2>/dev/null; then
		echo "shared holders active (heavy work running)"
	else
		echo "no holders"
	fi
	holders=$(slot_holders)
	busy=$(printf '%s' "$holders" | grep -c 'slot' || true)
	echo "heavy slots: $busy of $SLOTS busy"
	[ -z "$holders" ] || printf '%s\n' "$holders"
	;;
help|-h|--help)
	sed -n '2,41p' "$0"
	;;
*)
	echo "mlock: unknown command '$1' (run, quiet, check, status)" >&2
	exit 2
	;;
esac
