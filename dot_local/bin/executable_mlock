#!/usr/bin/env bash
# mlock — machine-sharing lock for concurrent agent sessions.
#
# A reader-writer lock over the machine. Heavy work (tests, builds,
# campaigns) runs as a shared holder; a quiet need (benchmark,
# measurement) takes the lock exclusively, which waits for every running
# shared holder to finish (the drain) and excludes new ones for its
# duration. flock(2) semantics give crash-release for free: a dead
# holder's lock vanishes with its process.
#
# flock has no writer priority, so a waiting quiet request leaves a
# `.wanted` marker carrying its reason: new heavy work holds off while
# the marker is inside its priority window (MLOCK_WANTED_HOLD seconds
# after each refresh, 300), and the waiting quiet refreshes it every
# MLOCK_WANTED_CYCLE seconds (600). The priority therefore comes in
# windows: a quiet stalled behind a long heavy holder blocks the other
# sessions half the time instead of starving them until that holder
# finishes. The marker's TTL bounds a crashed quiet-seeker.
#
#   mlock run <cmd...>              wait while quiet is wanted or held,
#                                   then run <cmd> as a shared holder;
#                                   the wait is unbounded, so a call
#                                   that may wait long runs with a
#                                   timeout sized for it or in the
#                                   background
#   mlock quiet <reason> <cmd...>   run <cmd> with the machine quiet;
#                                   the drain is bounded by
#                                   MLOCK_QUIET_WAIT (7200s; exit 75 =
#                                   rerun the same call), the hold by
#                                   MLOCK_QUIET_MAX (3600s) — past it
#                                   the command is interrupted and
#                                   mlock exits 124, so no quiet run
#                                   holds the machine longer than its
#                                   caller said it needed
#   mlock check                     exit 0 if heavy work may start now;
#                                   exit 1 and print why if not
#   mlock status                    human-readable state, the quiet
#                                   holder's reason, age and bound
#                                   included
#
# Environment: MLOCK_FILE (default ~/.machine.lock), MLOCK_TTL (wanted
# marker, default 7200), MLOCK_QUIET_WAIT (drain bound, default 7200),
# MLOCK_QUIET_MAX (hold bound, default 3600), MLOCK_WANTED_HOLD
# (priority window, default 300), MLOCK_WANTED_CYCLE (marker refresh
# period, default 600).
set -euo pipefail

LOCK="${MLOCK_FILE:-$HOME/.machine.lock}"
WANTED="$LOCK.wanted"
QUIETREC="$LOCK.quiet"
TTL_SECONDS="${MLOCK_TTL:-7200}"
QUIET_WAIT="${MLOCK_QUIET_WAIT:-7200}"
QUIET_MAX="${MLOCK_QUIET_MAX:-3600}"
WANTED_HOLD="${MLOCK_WANTED_HOLD:-300}"
WANTED_CYCLE="${MLOCK_WANTED_CYCLE:-600}"
TEMPFAIL=75

touch "$LOCK"

marker_age() { # prints the marker's age in seconds; exit 1 when absent
	# One stat is both the existence probe and the mtime read: a marker
	# removed concurrently (a quiet holder's EXIT trap) must read as
	# "not wanted", never crash the arithmetic.
	local mtime
	mtime=$(stat -c %Y "$1" 2>/dev/null) || return 1
	echo $(($(date +%s) - mtime))
}

fresh() { # marker exists and is younger than the TTL
	local age
	age=$(marker_age "$1") || return 1
	[ "$age" -le "$TTL_SECONDS" ]
}

priority() { # the marker is fresh and inside its current priority window
	local age
	age=$(marker_age "$1") || return 1
	[ "$age" -le "$TTL_SECONDS" ] && [ "$age" -lt "$WANTED_HOLD" ]
}

wanted_reason() { cat "$WANTED" 2>/dev/null || echo '?'; }
quiet_record() { cat "$QUIETREC" 2>/dev/null || echo '?'; }

blocked_reason() { # prints why heavy work may not start now; exit 0 when it may
	if priority "$WANTED"; then
		echo "quiet wanted: $(wanted_reason)"
		return 1
	fi
	if ! flock -n -s "$LOCK" true 2>/dev/null; then
		echo "machine quiet: $(quiet_record)"
		return 1
	fi
	return 0
}

case "${1:-help}" in
run)
	shift
	[ "$#" -ge 1 ] || { echo "mlock run: missing command" >&2; exit 2; }
	# Wait until no priority window is open and no exclusive holder is
	# active, checked together: a marker can appear while blocking on
	# the lock, so loop until both clear in one pass.
	while :; do
		if priority "$WANTED"; then
			sleep 5
			continue
		fi
		if flock -n -s "$LOCK" true 2>/dev/null; then
			break
		fi
		flock -s "$LOCK" true
	done
	exec flock -s "$LOCK" "$@"
	;;
quiet)
	shift
	[ "$#" -ge 2 ] || { echo "mlock quiet: usage: mlock quiet <reason> <cmd...>" >&2; exit 2; }
	reason="$1"
	shift
	printf '%s (pid %s, since %s)\n' "$reason" "$$" "$(date -Is)" >"$WANTED"
	# The refresher re-opens a priority window every cycle while this
	# request waits; it dies with the request.
	( while kill -0 "$$" 2>/dev/null; do sleep "$WANTED_CYCLE"; touch "$WANTED" 2>/dev/null; done ) &
	refresher=$!
	trap 'kill "$refresher" 2>/dev/null || true; rm -f "$WANTED" "$QUIETREC"' EXIT
	# The exclusive hold rides an fd this shell keeps open, so the drain
	# (-x waits for every shared holder to release) and the run are one
	# hold, inherited by the command's process tree.
	exec {qfd}>>"$LOCK"
	if ! flock -x -w "$QUIET_WAIT" -E "$TEMPFAIL" "$qfd"; then
		echo "mlock quiet: the machine did not drain within ${QUIET_WAIT}s — $reason" >&2
		exit "$TEMPFAIL"
	fi
	kill "$refresher" 2>/dev/null || true
	# Held. The wanted marker has done its job (priority while waiting);
	# the quiet record now carries the holder for status and check.
	rm -f "$WANTED"
	# The hold is bounded: a quiet run that outlives its stated bound is
	# interrupted rather than left holding the machine against everyone.
	# INT first so a measurement can render its ending; TERM 30s later;
	# timeout's own KILL after that.
	timeout --foreground --signal=INT --kill-after=30 "$QUIET_MAX" "$@" &
	child=$!
	printf '%s (pid %s, child %s, since %s, bound %ss)\n' "$reason" "$$" "$child" "$(date -Is)" "$QUIET_MAX" >"$QUIETREC"
	exec_status=0
	wait "$child" || exec_status=$?
	if [ "$exec_status" -eq 124 ]; then
		echo "mlock quiet: hold bound of ${QUIET_MAX}s reached — $reason interrupted; a longer quiet run sets MLOCK_QUIET_MAX to what it needs" >&2
	fi
	exit "$exec_status"
	;;
check)
	if reason=$(blocked_reason); then
		echo "free"
	else
		echo "$reason"
		exit 1
	fi
	;;
status)
	if priority "$WANTED"; then
		echo "quiet wanted (priority window open, heavy starts held): $(wanted_reason)"
	elif fresh "$WANTED"; then
		echo "quiet wanted (priority window lapsed, heavy starts allowed until the next refresh): $(wanted_reason)"
	elif [ -e "$WANTED" ]; then
		echo "stale wanted marker (older than ${TTL_SECONDS}s): $(wanted_reason)"
	fi
	if ! flock -n -s "$LOCK" true 2>/dev/null; then
		echo "exclusive holder active (machine quiet): $(quiet_record)"
	elif ! flock -n -x "$LOCK" true 2>/dev/null; then
		echo "shared holders active (heavy work running)"
	else
		echo "no holders"
	fi
	;;
help|-h|--help)
	sed -n '2,45p' "$0"
	;;
*)
	echo "mlock: unknown command '$1' (run, quiet, check, status)" >&2
	exit 2
	;;
esac
