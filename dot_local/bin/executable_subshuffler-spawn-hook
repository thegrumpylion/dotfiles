#!/usr/bin/env python3
"""Agent-spawn gate for agent sessions: a subagent starts only with capacity.

Reads the hook JSON on stdin (Claude Code's PreToolUse shape for the Agent
tool) and answers on stdout. The capacity reading is `subshuffler status
--json`: the selected account's ETA to its nearest threshold and the fleet's
mix hint. A spawn is denied only when the ETA is shorter than one round and no other
account has room to rotate onto (the agent would die at the provider's limit).
Every other spawn is admitted with the reading attached as context; when the
hint says Fable is at pace and only the total has room while the spawn asks
for Fable, the context nudges toward a non-Fable model where the choice is
free — the hint steers, it never blocks: points unspent at a deadline are the
only waste, early exhaustion is none. A missing or older
subshuffler, a failed read or a malformed document never bricks the
session: the spawn is admitted silently.

Environment: SPAWN_GATE_OFF=1 admits everything; SPAWN_GATE_MIN_ETA (seconds,
default 3600) is one round's length; SUBSHUFFLER_STATUS_JSON names a file
read instead of the daemon (tests)."""
import json
import os
import subprocess
import sys

SUBSHUFFLER = os.path.expanduser("~/.local/bin/subshuffler")
FABLE_MODELS = ("fable",)


def answer(decision, reason=None, context=None):
    output = {"hookEventName": "PreToolUse"}
    if decision:
        output["permissionDecision"] = decision
    if reason:
        output["permissionDecisionReason"] = reason
    if context:
        output["additionalContext"] = context
    print(json.dumps({"hookSpecificOutput": output}))
    sys.exit(0)


def reading():
    path = os.environ.get("SUBSHUFFLER_STATUS_JSON")
    if path:
        with open(path) as handle:
            return json.load(handle)
    probe = subprocess.run(
        [SUBSHUFFLER, "status", "--json"], capture_output=True, text=True, timeout=10
    )
    if probe.returncode != 0:
        return None
    return json.loads(probe.stdout)


def humane(seconds):
    if seconds is None:
        return "—"
    seconds = int(seconds)
    if seconds < 3600:
        return "%dm" % (seconds // 60)
    return "%dh%02dm" % (seconds // 3600, (seconds % 3600) // 60)


def rate(value):
    return "—" if value is None else "%.1f/h" % (value * 100)


if os.environ.get("SPAWN_GATE_OFF") == "1":
    sys.exit(0)
try:
    payload = json.load(sys.stdin)
except Exception:
    sys.exit(0)
if payload.get("tool_name") != "Agent":
    sys.exit(0)
try:
    status = reading()
    decision = status["decision"]
    fleet = status["fleet"]
except Exception:
    sys.exit(0)  # no reading: the gate never bricks the session

selected = decision.get("selected") or "none"
eta = decision.get("selected_eta_seconds")
hint = fleet.get("hint") or "no-reading"
line = (
    "capacity: %s five-hour %.0f%% (resets %s), Fable burn %s eta %s, total burn %s "
    "eta %s; fleet Fable %s of pace %s, total %s of pace %s; accounts with room %s; hint %s"
    % (
        selected,
        (decision.get("selected_five_hour") or 0) * 100,
        decision.get("selected_five_hour_reset") or "—",
        rate(decision.get("selected_fable_burn")),
        humane(decision.get("selected_fable_eta_seconds")),
        rate(decision.get("selected_total_burn")),
        humane(decision.get("selected_total_eta_seconds")),
        rate(fleet.get("fable_burn")),
        rate(fleet.get("fable_pace")),
        rate(fleet.get("total_burn")),
        rate(fleet.get("total_pace")),
        "—" if fleet.get("accounts_with_room") is None else fleet.get("accounts_with_room"),
        hint,
    )
)

minimum = int(os.environ.get("SPAWN_GATE_MIN_ETA", "3600"))
room = fleet.get("accounts_with_room")
if eta is not None and eta < minimum and room == 0:
    answer(
        "deny",
        "no capacity for a new agent: the selected account %s reaches its limit in %s, "
        "shorter than one round (%s), and no other account has both weekly room and a free "
        "five-hour window to rotate onto — the agent would die at the provider's limit. Wait "
        "for a window reset (`subshuffler status` shows each reset), or shorten the round. %s"
        % (selected, humane(eta), humane(minimum), line),
    )

model = ((payload.get("tool_input") or {}).get("model") or "").lower()
asks_fable = model == "" or any(name in model for name in FABLE_MODELS)
if hint == "add-non-fable" and asks_fable:
    line += (
        " — Fable is at pace and only the total weekly has room: where the next agent's "
        "model is a choice (a review, a mechanical round), prefer model: \"opus\"; a Fable "
        "round on the critical path is fine, early exhaustion is not waste."
    )
answer(None, context=line)
